# 复制为 .env 后填写（.env 不入库）
#
# 模式一：离线占位（无需 Key，仅用于验证程序能否跑通）
# MEETING_AGENT_PROVIDER=echo
#
# 模式二：DeepSeek（填好下面四项后，把 PROVIDER 改成 openai_compatible）
# MEETING_AGENT_PROVIDER=openai_compatible
# MEETING_AGENT_BASE_URL=https://api.deepseek.com/v1
# MEETING_AGENT_MODEL=deepseek-chat
# MEETING_AGENT_API_KEY=sk-你的密钥

MEETING_AGENT_PROVIDER=echo

# openai_compatible 模式下必填
MEETING_AGENT_BASE_URL=
MEETING_AGENT_API_KEY=
MEETING_AGENT_MODEL=

# 可选参数
MEETING_AGENT_TEMPERATURE=0.3
MEETING_AGENT_MAX_STEPS=8
MEETING_AGENT_MAX_HISTORY=40
MEETING_AGENT_LOG_LEVEL=INFO
